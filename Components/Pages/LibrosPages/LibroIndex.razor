@page "/Libro/Index"
@page "/"
@inject LibrosService gestionLibros

<PageTitle>Registro de Libros</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Libros</h5>
            <a href="/Libro/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Titulo">Título</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid">
                <QuickGrid Items="@librosQueryable" Class="table table-hover mt-3 table-striped">
                    <PropertyColumn Property="@(l => l.LibroId)" Title="LibroId" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Titulo)" Title="Título" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Autor)" Title="Autor" Sortable="true" />
                    <PropertyColumn Property="@(l => l.anoPublicacion)" Title="Año de Publicación" Sortable="true" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <a href="/Libro/Edit/@context.LibroId" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i></a>
                        <button type="button" class="btn btn-outline-danger ms-2" @onclick="() => OnShowModalClick(context.LibroId)"><i class="bi bi-trash"></i></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label class="mb-0">Cantidad:  @ListaLibros.Count()</label>
        </div>
    </div>
</div>

<Modal @ref="modal" Title="Confirmar Eliminación">
    <BodyTemplate>
        <p>¿Está seguro de que desea eliminar este libro?</p>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
        <Button Color="ButtonColor.Danger" @onclick="EliminarLibro">Eliminar</Button>
    </FooterTemplate>
</Modal>

@code {
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();
    IQueryable<Libros>? librosQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private Modal modal = default!;
    private int libroIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await gestionLibros.GetList(p => p.LibroId > 0);
        librosQueryable = ListaLibros.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Titulo")
            {
                ListaLibros = await gestionLibros.GetList(p => p.Titulo!.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Autor")
            {
                ListaLibros = await gestionLibros.GetList(p => p.Autor!.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
            ListaLibros = await gestionLibros.GetList(p => p.LibroId > 0);
            
        librosQueryable = ListaLibros.AsQueryable();
    }

    private async Task OnShowModalClick(int id)
    {
        libroIdToDelete = id;
        await modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task EliminarLibro()
    {
        var eliminado = await gestionLibros.Eliminar(libroIdToDelete);
        if (eliminado)
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            ListaLibros = await gestionLibros.GetList(p => p.LibroId > 0);
            librosQueryable = ListaLibros.AsQueryable();
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el libro.");
        }
        await modal.HideAsync();
    }
}