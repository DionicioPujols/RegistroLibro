@page "/Libro/Edit/{LibroId:int}"

@inject LibrosService gestionLibros
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Libro</PageTitle>
<EditForm Model="Libro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Libro</h5>
            </div>

            @* Título *@
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Título</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                    <ValidationMessage For="(() => Libro.Titulo)" />
                </div>

                @* Autor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                    <ValidationMessage For="(() => Libro.Autor)" />
                </div>

                @* Año de Publicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Año de Publicación</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.anoPublicacion"></InputNumber>
                    <ValidationMessage For="(() => Libro.anoPublicacion)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Libro/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary ms-2"><i class="bi bi-floppy"></i> Modificar</button>
                <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash"></i> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel">Confirmar Eliminación</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este préstamo?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="EliminarLibro">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int LibroId { get; set; }

    public Libros Libro { get; set; } = new Libros();

    protected override async Task OnInitializedAsync()
    {
        Libro = await gestionLibros.Buscar(LibroId) ?? new Libros();
    }

    public async Task Modificar()
    {
        Libro.Titulo = Libro.Titulo?.Trim();

        var tituloExiste = await gestionLibros.GetList(l => l.Titulo!.ToLower() == Libro.Titulo!.ToLower() && l.LibroId != Libro.LibroId);

        if (tituloExiste.Any())
        {
            toastService.ShowError("Ya existe otro libro registrado con este título.");
            return;
        }

        var modificado = await gestionLibros.Guardar(Libro);

        if (modificado)
        {
            toastService.ShowSuccess("Se ha modificado correctamente.");
            navigationManager.NavigateTo("/Libro/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar correctamente.");
        }
    }

    private async Task EliminarLibro()
    {
        var eliminado = await gestionLibros.Eliminar(LibroId);
        if (eliminado)
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            navigationManager.NavigateTo("/Libro/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el libro.");
        }
    }
}
