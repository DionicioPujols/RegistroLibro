@page "/Prestamo/Edit/{PrestamoId:int}"

@inject PrestamosService prestamosService
@inject EstudiantesService estudiantesService
@inject LibrosService librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Editar Préstamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Préstamo</h5>
            </div>

            <div class="card-body">
                @* Fecha *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.Fecha"></InputDate>
                    <ValidationMessage For="(() => Prestamo.Fecha)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0" disabled>Seleccione un libro</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* Estudiante *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0" disabled>Seleccione un estudiante</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash"></i> Eliminar</button>
                <button type="submit" class="btn btn-success ms-2"><i class="bi bi-floppy"></i> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel">Confirmar Eliminación</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este préstamo?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="EliminarPrestamo">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }

    public Prestamos Prestamo { get; set; } = new Prestamos();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.GetList(e => true);
        ListaLibros = await librosService.GetList(l => true);
        Prestamo = await prestamosService.Buscar(PrestamoId) ?? new Prestamos();
    }

    public async Task Guardar()
    {
        if(Prestamo.EstudianteId == 0)
        {
            toastService.ShowError("Debe seleccionar un estudiante.");
            return;
        }

        if(Prestamo.LibroId == 0)
        {
            toastService.ShowError("Debe seleccionar un libro.");
            return;
        }

        var modificado = await prestamosService.Guardar(Prestamo);
        if (modificado)
        {
            toastService.ShowSuccess("Préstamo modificado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo modificar el préstamo.");
        }
    }

    private async Task EliminarPrestamo()
    {
        var eliminado = await prestamosService.Eliminar(PrestamoId);
        if (eliminado)
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el préstamo.");
        }
    }
}
