@page "/Devolucion/Edit/{DevolucionId:int}"

@inject DevolucionesService devolucionesService
@inject PrestamosService prestamosService
@inject ToastService toastService
@inject NavigationManager navigationManager

<PageTitle>Consultar / Eliminar Devolución</PageTitle>
<EditForm Model="Devolucion" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Consultar Devolución</h5>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Devolucion.Fecha" readonly></InputDate>
                </div>

                <div class="mb-3">
                    <label class="form-label"><strong>Préstamo</strong></label>
                    <InputSelect class="form-select" @bind-Value="Devolucion.PrestamoId" disabled>
                        <option value="0" disabled>Seleccione un préstamo</option>
                        @foreach (var prestamo in ListaPrestamos)
                        {
                            <option value="@prestamo.PrestamoId">Libro: @prestamo.Libro?.Titulo - Estudiante: @prestamo.Estudiante?.nombre</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="card-footer text-center mt-2">
                <a href="/Devolucion/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="button" class="btn btn-danger ms-2" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash"></i> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteModalLabel">Confirmar Eliminación</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar esta devolución? El préstamo asociado volverá a estar como no devuelto.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="EliminarDevolucion">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int DevolucionId { get; set; }

    public Devoluciones Devolucion { get; set; } = new Devoluciones();
    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();

    protected override async Task OnInitializedAsync()
    {
        Devolucion = await devolucionesService.Buscar(DevolucionId) ?? new Devoluciones()ñ
        ListaPrestamos = await prestamosService.GetList(p => true);
    }

    public async Task Guardar()
    {
        
    }

    private async Task EliminarDevolucion()
    {
        var prestamo = await prestamosService.Buscar(Devolucion.PrestamoId);
        if(prestamo != null)
        {
            prestamo.Devuelto = false;
            await prestamosService.Modificar(prestamo);
        }

        var eliminado = await devolucionesService.Eliminar(DevolucionId);
        if (eliminado)
        {
            toastService.ShowSuccess("Devolución eliminada correctamente.");
            navigationManager.NavigateTo("/Devolucion/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar la devolución.");
        }
    }
}
