@page "/Estudiante/Index"

@inject EstudiantesService estudiantesService
@inject ToastService toastService

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="/Estudiante/Create" class="btn btn-primary"><i class="bi bi-plus-square"></i> Crear</a>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Busqueda</strong></label>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opcion</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Direccion">Dirección</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary" @onclick="Buscar"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>

            <div class="grid">
                <QuickGrid Items="@estudiantesQueryable" Class="table table-hover mt-3 table-striped">
                    <PropertyColumn Property="@(e => e.EstudianteId)" Title="EstudianteId" Sortable="true" />
                    <PropertyColumn Property="@(e => e.nombre)" Title="Nombre" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Direccion)" Title="Dirección" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Correo)" Title="Correo" Sortable="true" />
                    <PropertyColumn Property="@(e => e.FechaNacimeinto)" Title="Fecha de Nac." Format="d" Sortable="true" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <a href="/Estudiante/Edit/@context.EstudianteId" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label class="mb-0">Cantidad:  @ListaEstudiantes.Count()</label>
        </div>
    </div>
</div>


@code {
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    IQueryable<Estudiantes>? estudiantesQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private int estudianteIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.GetList(p => true);
        estudiantesQueryable = ListaEstudiantes.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Nombre")
            {
                ListaEstudiantes = await estudiantesService.GetList(p => p.nombre!.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Direccion")
            {
                ListaEstudiantes = await estudiantesService.GetList(p => p.Direccion!.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
            ListaEstudiantes = await estudiantesService.GetList(p => true);
            
        estudiantesQueryable = ListaEstudiantes.AsQueryable();
    }

    private async Task EliminarEstudiante()
    {
        var eliminado = await estudiantesService.Eliminar(estudianteIdToDelete);
        if (eliminado)
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            ListaEstudiantes = await estudiantesService.GetList(p => true);
            estudiantesQueryable = ListaEstudiantes.AsQueryable();
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el estudiante.");
        }
    }
}
