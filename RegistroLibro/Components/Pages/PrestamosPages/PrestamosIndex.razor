@page "/Prestamo/Index"

@inject PrestamosService prestamosService
@inject ToastService toastService

<PageTitle>Registro de Préstamos</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Préstamos</h5>
            <a href="/Prestamo/Create" class="btn btn-primary"><i class="bi bi-plus-square"></i> Crear</a>
        </div>

        @*Controles de busqueda*@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opción</option>
                        <option value="ID">ID</option>
                        <option value="Estudiante">Estudiante</option>
                    </InputSelect>
                </div>
                
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary" @onclick="Buscar"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>

            <div class="grid">
                <QuickGrid Items="@prestamosQueryable" Class="table table-hover mt-3 table-striped">
                    <PropertyColumn Property="@(p => p.PrestamoId)" Title="PrestamoId" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Fecha)" Title="Fecha" Format="d" Sortable="true" />
                    <TemplateColumn Title="Estudiante">@context.Estudiante?.nombre</TemplateColumn>
                    <TemplateColumn Title="Libro">@context.Libro?.Titulo</TemplateColumn>
                    <TemplateColumn Title="Devuelto">
                        @(context.Devuelto ? "Sí" : "No")
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <a href="/Prestamo/Edit/@context.PrestamoId" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label class="mb-0">Cantidad:  @ListaPrestamos.Count()</label>
        </div>
    </div>
</div>

@code {
    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();
    IQueryable<Prestamos>? prestamosQueryable;

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private int prestamoIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        var result = await prestamosService.GetList(p => true);
        result.OnSuccess(p => ListaPrestamos = p);
        prestamosQueryable = ListaPrestamos.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "ID" && int.TryParse(ValorFiltro, out int id))
            {
                var result = await prestamosService.GetList(p => p.PrestamoId == id);
                result.OnSuccess(p => ListaPrestamos = p);
            }
            else if (Filtro == "Estudiante")
            {
                var result = await prestamosService.GetList(p => p.Estudiante!.nombre!.ToLower().Contains(ValorFiltro.ToLower()));
                result.OnSuccess(p => ListaPrestamos = p);
            }
        }
        else
        {
            var result = await prestamosService.GetList(p => true);
            result.OnSuccess(p => ListaPrestamos = p);
        }
            
        prestamosQueryable = ListaPrestamos.AsQueryable();
    }

    private async Task EliminarPrestamo()
    {
        var result = await prestamosService.Eliminar(prestamoIdToDelete);
        result.OnSuccess(async () =>
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente.");
            var listResult = await prestamosService.GetList(p => true);
            listResult.OnSuccess(p => ListaPrestamos = p);
            prestamosQueryable = ListaPrestamos.AsQueryable();
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar el préstamo."));
    }
}
