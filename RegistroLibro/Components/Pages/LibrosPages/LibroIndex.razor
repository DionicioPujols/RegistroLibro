@page "/Libro/Index"
@page "/"

@inject LibrosService gestionLibros
@inject DevolucionesService devolucionesService
@inject ToastService toastService

<PageTitle>Registro de Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Libros</h5>
            <a href="/Libro/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Titulo">Título</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid">
                <QuickGrid Items="@librosQueryable" Class="table table-hover mt-3 table-striped">
                    <PropertyColumn Property="@(l => l.LibroId)" Title="LibroId" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Titulo)" Title="Título" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Autor)" Title="Autor" Sortable="true" />
                    <PropertyColumn Property="@(l => l.anoPublicacion)" Title="Año de Publicación" Sortable="true" />
                    <PropertyColumn Property="@(l => l.CantidadDisponible)" Title="Cantidad Disponible" Sortable="true" />
                    <PropertyColumn Property="@(l => ObtenerPromedioDiasPrestado(l.LibroId))" Title="Promedio de días prestado" Sortable="true" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <a href="/Libro/Edit/@context.LibroId" class="btn btn-outline-primary"><i class="bi bi-pencil-square"></i></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <label class="mb-0">Cantidad:  @ListaLibros.Count()</label>
        </div>
    </div>
</div>

@code {
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();
    IQueryable<Libros>? librosQueryable;
    private Dictionary<int, double> promediosPorLibro = new();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    private int libroIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        var result = await gestionLibros.GetList(p => true);
        result.OnSuccess(libros => ListaLibros = libros);
        librosQueryable = ListaLibros.AsQueryable();
        await CargarPromedios();
    }

    private async Task CargarPromedios()
    {
        var devolucionesResult = await devolucionesService.GetList(d => true);
        List<Devoluciones> devoluciones = new();
        devolucionesResult.OnSuccess(d => devoluciones = d);

        promediosPorLibro = devoluciones
            .Where(d => d.Prestamo != null)
            .GroupBy(d => d.Prestamo!.LibroId)
            .ToDictionary(
                g => g.Key,
                g =>
                {
                    double sumaDias = 0;
                    foreach (var devolucion in g)
                    {
                        var diferenciaDias = (devolucion.Fecha.Date - devolucion.Prestamo!.Fecha.Date).Days;
                        sumaDias += Math.Max(0, diferenciaDias);
                    }
                    return Math.Round(sumaDias / g.Count(), 2);
                });
    }

    public double ObtenerPromedioDiasPrestado(int libroId)
    {
        return promediosPorLibro.GetValueOrDefault(libroId, 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Titulo")
            {
                var result = await gestionLibros.GetList(p => p.Titulo!.ToLower().Contains(ValorFiltro.ToLower()));
                result.OnSuccess(libros => ListaLibros = libros);
            }
            else if (Filtro == "Autor")
            {
                var result = await gestionLibros.GetList(p => p.Autor!.ToLower().Contains(ValorFiltro.ToLower()));
                result.OnSuccess(libros => ListaLibros = libros);
            }
        }
        else
        {
            var result = await gestionLibros.GetList(p => true);
            result.OnSuccess(libros => ListaLibros = libros);
        }
            
        librosQueryable = ListaLibros.AsQueryable();
    }

    private async Task EliminarLibro()
    {
        var result = await gestionLibros.Eliminar(libroIdToDelete);
        result.OnSuccess(async () =>
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            var listResult = await gestionLibros.GetList(p => true);
            listResult.OnSuccess(libros => ListaLibros = libros);
            librosQueryable = ListaLibros.AsQueryable();
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar el libro."));
    }

    public async Task<double> CalcularPromedioDiasPrestado(int libroId)
    {
        var result = await devolucionesService.GetList(d => d.Prestamo != null && d.Prestamo.LibroId == libroId);
        List<Devoluciones> devoluciones = new();
        result.OnSuccess(d => devoluciones = d);

        if (devoluciones.Count == 0)
        {
            return 0;
        }

        double sumaDias = 0;
        foreach (var devolucion in devoluciones)
        {
            var diferenciaDias = (devolucion.Fecha.Date - devolucion.Prestamo!.Fecha.Date).Days;
            sumaDias += Math.Max(0, diferenciaDias);
        }
        return Math.Round(sumaDias / devoluciones.Count, 2);
    }
}
