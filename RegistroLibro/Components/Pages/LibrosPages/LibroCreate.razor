@page "/Libro/Create"

@inject LibrosService gestionLibros
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Create</PageTitle>
<EditForm Model="Libro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear Libro</h5>
            </div>

            @* Título *@
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Título</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                    <ValidationMessage For="(() => Libro.Titulo)" />
                </div>

                @* Autor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                    <ValidationMessage For="(() => Libro.Autor)" />
                </div>

                @* Año de Publicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Año de Publicación</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.anoPublicacion"></InputNumber>
                    <ValidationMessage For="(() => Libro.anoPublicacion)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Libro/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary ms-2"><i class="bi bi-floppy"></i> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Libros Libro { get; set; } = new Libros();

    public async Task Guardar()
    {
        Libro.Titulo = Libro.Titulo?.Trim();

        var tituloExiste = await gestionLibros.GetList(l => l.Titulo!.ToLower() == Libro.Titulo!.ToLower());
        
        bool yaExiste = false;
        tituloExiste.OnSuccess(lista => yaExiste = lista.Any());

        if (yaExiste)
        {
            toastService.ShowError("Ya existe un libro registrado con este título.");
            return; 
        }

        var result = await gestionLibros.Guardar(Libro);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Libro guardado correctamente.");
            navigationManager.NavigateTo("/Libro/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo guardar el libro."));
    }
}
